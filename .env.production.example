# Copy to .env.production and replace every placeholder.
# Generate each password/secret with: openssl rand -hex 32
# Use hex (or base64url without padding): these values are embedded in database
# URLs, where characters such as / + = would need percent-encoding.
#
# The production settings validator refuses to start the API unless:
#   SIH_JWT_SECRET is at least 32 random characters
#   SIH_DATABASE_URL is PostgreSQL (Compose supplies it)
#   SIH_CORS_ORIGINS and SIH_ALLOWED_HOSTS list explicit values
#   SIH_SEED_ON_STARTUP=false, the clock is real, and SIH_DEBUG=false

POSTGRES_DB=sih26262
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-random-superuser-password

SIH_MIGRATOR_PASSWORD=replace-with-a-random-migrator-password
SIH_APP_RW_PASSWORD=replace-with-a-random-application-password
SIH_SIM_RO_PASSWORD=replace-with-a-random-rehearsal-reader-password
SIH_SIM_RW_PASSWORD=replace-with-a-random-rehearsal-writer-password

# Dedicated schema for rehearsal results. Must not be public.
SIH_SIMULATION_SCHEMA=sim

SIH_JWT_SECRET=replace-with-at-least-32-random-characters
SIH_PASSWORD_HASH_ITERATIONS=260000
SIH_ACCESS_TOKEN_MINUTES=480

# The frontend origin as seen by a browser, and the hostnames the API accepts.
SIH_CORS_ORIGINS=["https://aicte.example.gov.in"]
SIH_ALLOWED_HOSTS=["api.aicte.example.gov.in","aicte.example.gov.in"]
SIH_HSTS_SECONDS=31536000

# Set to an absolute API URL when the frontend is served from a different origin.
SIH_PUBLIC_API_BASE=https://api.aicte.example.gov.in/api/v1

# Bind to localhost when TLS and routing are terminated by a reverse proxy.
API_BIND=127.0.0.1:8000
WEB_BIND=127.0.0.1:8080

SIH_LOG_LEVEL=INFO
SIH_LOG_JSON=true
SIH_DOCS_ENABLED=false
SIH_DEBUG=false
SIH_SEED_ON_STARTUP=false
SIH_CLOCK_MODE=system

# Only enable when a trusted reverse proxy overwrites X-Forwarded-For.
SIH_TRUST_PROXY_HEADERS=false

# Database pool / timeout knobs.
SIH_DB_POOL_SIZE=10
SIH_DB_MAX_OVERFLOW=20
SIH_DB_STATEMENT_TIMEOUT_MS=30000

# Sign-in throttling.
SIH_LOGIN_MAX_ATTEMPTS=5
SIH_LOGIN_MAX_ATTEMPTS_PER_IP=25
SIH_LOGIN_WINDOW_SECONDS=900
SIH_LOGIN_LOCKOUT_SECONDS=900
