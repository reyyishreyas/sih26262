# Copy to .env for local development. Every setting is prefixed SIH_.
# The defaults below are deliberately non-production.

SIH_ENV=dev
SIH_DATABASE_URL=sqlite:///./sih26262.db
SIH_SIMULATION_READONLY_URL=
SIH_SIMULATION_RESULTS_URL=
# PostgreSQL only. Set to `sim` to keep simulation tables in a dedicated schema.
# Leave empty for SQLite (which has no schemas).
SIH_SIMULATION_SCHEMA=

# Replace before exposing the API to anything but localhost.
SIH_JWT_SECRET=dev-only-change-me
SIH_ACCESS_TOKEN_MINUTES=480
SIH_PASSWORD_HASH_ITERATIONS=260000

# system | fixed | offset. `fixed` requires SIH_CLOCK_FIXED_AT and is what the
# tests and the recorded demo use.
SIH_CLOCK_MODE=fixed
SIH_CLOCK_FIXED_AT=2026-10-22T09:00:00+00:00
SIH_CLOCK_OFFSET_DAYS=0
SIH_DISPLAY_TIMEZONE=Asia/Kolkata
SIH_BUSINESS_TIMEZONE=Asia/Kolkata

SIH_STORAGE_DIR=./storage
SIH_MAX_UPLOAD_BYTES=10485760
SIH_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SIH_ALLOWED_HOSTS=["*"]
SIH_SEED_ON_STARTUP=false

# AI / LLM Integration (Evidence-Grounded AI Extraction & Decision Copilot).
# When provided, Gemini 1.5 Flash is invoked for evidence-grounded extraction
# with verbatim citations and reasoning. If empty or unset, the engine automatically
# falls back to a deterministic local grounded parser (offline-friendly).
SIH_GEMINI_API_KEY=
# Alternatively, the standard variable name is also supported:
# GEMINI_API_KEY=

# OpenRouter vision fallback. A key alone does not enable external processing.
# Keep disabled unless explicitly approved; code also requires trusted
# public/synthetic document provenance and low page confidence.
SIH_OPENROUTER_ENABLED=false
SIH_OPENROUTER_API_KEY=
SIH_OPENROUTER_MODEL=google/gemini-2.5-flash
SIH_OPENROUTER_CONFIDENCE_THRESHOLD=0.75
SIH_OPENROUTER_TIMEOUT_SECONDS=20

# Operability and security. Production validation rejects unsafe values.
SIH_DEBUG=false
# /docs, /redoc and /openapi.json are a second sign-in door: turn them on only
# on a restricted network. Sign-in itself only accepts the UI's origin.
SIH_DOCS_ENABLED=false
SIH_LOG_LEVEL=INFO
SIH_LOG_JSON=true
SIH_HSTS_SECONDS=31536000
SIH_TRUST_PROXY_HEADERS=false

# Connection pool / query bounds (PostgreSQL only).
SIH_DB_POOL_SIZE=10
SIH_DB_MAX_OVERFLOW=20
SIH_DB_POOL_TIMEOUT_SECONDS=30
SIH_DB_POOL_RECYCLE_SECONDS=1800
SIH_DB_CONNECT_TIMEOUT_SECONDS=5
SIH_DB_STATEMENT_TIMEOUT_MS=30000

# Persisted sign-in throttling (works across API replicas and restarts).
SIH_LOGIN_MAX_ATTEMPTS=5
SIH_LOGIN_MAX_ATTEMPTS_PER_IP=25
SIH_LOGIN_WINDOW_SECONDS=900
SIH_LOGIN_LOCKOUT_SECONDS=900

# Non-production only: production requires SIH_JWT_SECRET >= 32 random chars,
# explicit CORS origins and allowed hosts, PostgreSQL, a real clock and no seeding.
SIH_JWT_ISSUER=sih26262
SIH_JWT_AUDIENCE=sih26262-api
SIH_JWT_LEEWAY_SECONDS=30

# PostgreSQL example (used by docker compose):
# SIH_DATABASE_URL=postgresql+psycopg://app_rw:app_rw_dev@db:5432/sih26262
# SIH_SIMULATION_READONLY_URL=postgresql+psycopg://sim_prod_ro:sim_prod_ro_dev@db:5432/sih26262
# SIH_SIMULATION_RESULTS_URL=postgresql+psycopg://sim_results_rw:sim_results_rw_dev@db:5432/sih26262
# SIH_SIMULATION_SCHEMA=sim
# Migrations run as a separate role: sih_migrator. See backend/sql/bootstrap_roles.sql.
